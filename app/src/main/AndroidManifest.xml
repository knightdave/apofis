<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 blocks apps targeting it from LAN addresses without this runtime permission; asked for only when
         the server is on the local network. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Android 13+: needed to show the "reply finished" and "needs your answer" notifications; asked once, at the first send. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No foreground service by design: the app must never call setForeground or use long-running workers. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- The only distributor the app uses (PushRegistrar picks it by package, no chooser). -->
    <queries>
        <package android:name="io.heckel.ntfy" />
    </queries>

    <application
        android:name=".ApofisApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true">
        <!-- WorkManager's foreground service, removed with the permission above. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
        <!-- UnifiedPush: our receiver replaces the library's. Its bind service (a priority boost only) and its distributor
             chooser are not used. Exported: distributors deliver here; the connector drops any event without a known token. -->
        <receiver
            android:name=".push.PushReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="org.unifiedpush.android.connector.internal.MessagingReceiverImpl"
            tools:node="remove" />
        <service
            android:name="org.unifiedpush.android.connector.internal.RaiseToForegroundService"
            tools:node="remove" />
        <activity
            android:name="org.unifiedpush.android.connector.internal.LinkActivity"
            tools:node="remove" />
        <!-- singleTask: a second instance would take over the app-wide Back target the Connect screen uses. -->
        <!-- adjustResize: the system does not pan the window for the keyboard; the chat applies the keyboard inset itself
             (imePadding), once. With the default the window was panned as well and the composer moved up twice. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
